---
import Base from '../layouts/Base.astro';
---

<Base title="404: Page Not Found">
  <section class="mx-auto flex min-h-[50vh] max-w-3xl flex-col items-center justify-center px-4 py-12 text-center">
    <span class="mb-5 rounded-full border border-accent/20 bg-accent/10 px-3 py-1 font-mono text-xs font-semibold text-accent">404 ERROR</span>
    <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Page not found</h1>
    <p class="mt-3 max-w-xl text-base leading-relaxed text-muted">The page you are looking for doesn't exist, was moved, or is still being written.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-black transition-colors hover:bg-accent-hover">Back to Home</a>
      <a href="/blog" class="rounded-lg border border-white/10 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-accent/50 hover:text-accent">Explore Blog</a>
      <a href="/projects" class="rounded-lg border border-white/10 px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-accent/50 hover:text-accent">View Projects</a>
    </div>
  </section>
</Base>
