---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Search" subtitle="Search articles, projects, and notes." containerWidth="narrow">
  <div id="pagefind-standalone-container" class="w-full">
    <div id="pagefind-search"></div>
  </div>
</PageLayout>

<script>
  function loadPagefind() {
    const target = document.querySelector<HTMLElement>('#pagefind-search');
    if (!target || target.dataset.initialized === 'true') return;
    // PagefindUI is loaded globally by Base.astro.
    // @ts-ignore
    if (typeof PagefindUI !== 'undefined') {
      // @ts-ignore
      new PagefindUI({
        element: '#pagefind-search',
        showSubresults: true,
        showImages: false,
        resetStyles: false,
      });
      target.dataset.initialized = 'true';
    }
  }

  document.addEventListener('astro:page-load', loadPagefind);
  loadPagefind();
</script>
