---
import Base from '../layouts/Base.astro';
---

<Base title="Search">
  <div class="container-narrow px-4 py-8">
    <h1 class="text-2xl font-bold mb-4">Search Articles</h1>

    <div id="pagefind-standalone-container" class="w-full">
      <div id="pagefind-search"></div>
    </div>
  </div>
</Base>

<script>
  function loadPagefind() {
    // @ts-ignore
    if (typeof PagefindUI !== 'undefined') {
      // @ts-ignore
      new PagefindUI({
        element: '#pagefind-search',
        showSubresults: true,
        showImages: false,
        resetStyles: false
      });
    }
  }
  document.addEventListener('DOMContentLoaded', loadPagefind);
  document.addEventListener('astro:page-load', loadPagefind);
</script>