---
import PageLayout from '../layouts/PageLayout.astro';

const testimonials = [
  {
    quote: "Habin consistently delivers clean, high-performance web systems. His focus on simplicity and architecture is top-tier.",
    author: "Jane Doe",
    role: "Engineering Lead",
    company: "TechCorp",
  },
  {
    quote: "One of the most pragmatic developers I've worked with. Excellent problem-solving skills across cloud infrastructure.",
    author: "John Smith",
    role: "Senior Staff Engineer",
    company: "DevCloud",
  },
];
---

<PageLayout title="Testimonials" subtitle="Kind words from colleagues, leaders, and peers I've collaborated with." containerWidth="narrow">
  <section aria-label="Testimonials" class="space-y-5">
    {testimonials.map((item) => (
      <figure class="glass-card space-y-4">
        <blockquote class="text-base italic leading-relaxed text-neutral-100 sm:text-lg">“{item.quote}”</blockquote>
        <figcaption class="flex flex-col border-t border-white/10 pt-3 text-sm">
          <strong class="font-semibold text-white">{item.author}</strong>
          <span class="text-muted">{item.role} at {item.company}</span>
        </figcaption>
      </figure>
    ))}
  </section>
</PageLayout>
