---
import Base from '../layouts/Base.astro';

const testimonials = [
  {
    quote: "Habin consistently delivers clean, high-performance web systems. His focus on simplicity and architecture is top-tier.",
    author: "Jane Doe",
    role: "Engineering Lead",
    company: "TechCorp"
  },
  {
    quote: "One of the most pragmatic developers I've worked with. Excellent problem-solving skills across cloud infrastructure.",
    author: "John Smith",
    role: "Senior Staff Engineer",
    company: "DevCloud"
  }
];
---

<Base title="Testimonials">
  <div class="container-wide px-4 sm:px-0 py-4 sm:py-6">
    <section class="page-header">
      <h1>Testimonials</h1>
      <p class="subtitle">Kind words from colleagues, leaders, and peers I've collaborated with.</p>
    </section>

    <div class="testimonials-list">
      {testimonials.map(item => (
        <figure class="glass-card testimonial-card">
          <blockquote>"{item.quote}"</blockquote>
          <figcaption>
            <strong>{item.author}</strong>
            <span class="role">{item.role} at {item.company}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-header { margin-bottom: 1.5rem; }
  .page-header h1 { font-size: 1.75rem; font-weight: 800; margin: 0 0 0.5rem 0; }
  .subtitle { color: var(--muted); font-size: 0.95rem; margin: 0; }

  @media (min-width: 640px) {
    .page-header { margin-bottom: 2rem; }
    .page-header h1 { font-size: 2.25rem; }
    .subtitle { font-size: 1.05rem; }
  }

  .testimonials-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .testimonial-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 12px;
  }

  blockquote {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text);
    font-style: italic;
  }

  @media (min-width: 640px) {
    blockquote { font-size: 1.05rem; }
  }

  figcaption {
    display: flex;
    flex-direction: column;
    font-size: 0.875rem;
    border-top: 1px solid var(--surface-border);
    padding-top: 0.75rem;
  }

  figcaption strong { color: var(--text); font-weight: 600; }
  .role { color: var(--muted); }
</style>