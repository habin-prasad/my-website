---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft) || [];
const publishedPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Categories mapped directly to your Landing Page Palettes
const categories = [
  { 
    key: 'all', 
    label: 'All Writing', 
    colorClass: 'border-accent text-accent bg-accent/10',
    dotColor: 'bg-accent'
  },
  { 
    key: 'platform-infra', 
    label: 'Platform & Infrastructure', 
    colorClass: 'border-cyan-500/40 text-cyan-400 bg-cyan-500/10',
    dotColor: 'bg-cyan-400',
    tags: ['architecture', 'distributed-systems', 'kubernetes', 'docker', 'aws', 'terraform', 'rust', 'go', 'performance', 'cloud']
  },
  { 
    key: 'quality-automation', 
    label: 'Quality & Automation', 
    colorClass: 'border-emerald-500/40 text-emerald-400 bg-emerald-500/10',
    dotColor: 'bg-emerald-400',
    tags: ['ci-cd', 'testing', 'automation', 'devops', 'astro', 'typescript', 'web-platform', 'dx']
  },
  { 
    key: 'engineering-leadership', 
    label: 'Engineering Leadership', 
    colorClass: 'border-purple-500/40 text-purple-400 bg-purple-500/10',
    dotColor: 'bg-purple-400',
    tags: ['leadership', 'strategy', 'culture', 'mentorship', 'process', 'management', 'architecture-reviews']
  },
];
---

<Base title="Engineering Journal">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    
    <!-- Header -->
    <header class="space-y-2 border-b border-white/10 pb-6 mb-8">
      <span class="text-xs font-mono text-accent uppercase tracking-widest block">TECHNICAL WRITING</span>
      <h1 class="text-3xl md:text-4xl font-bold text-white tracking-tight">Engineering Journal</h1>
      <p class="text-neutral-400 text-sm md:text-base max-w-2xl">
        Notes, architecture breakdowns, and strategy on platforms, automation, and leadership.
      </p>
    </header>

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
      
      <!-- Article Feed (Spans 3 Columns) -->
      <main class="lg:col-span-3 space-y-4">
        <div class="flex justify-between items-center text-xs font-mono text-neutral-400 pb-2 border-b border-white/5">
          <span id="active-category-label">CATEGORY: ALL WRITING ({publishedPosts.length})</span>
          <span class="hidden sm:inline">SORT: MOST RECENT</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="posts-grid">
          {publishedPosts.map(post => (
            <div 
              class="blog-card-item" 
              data-tags={JSON.stringify(post.data.tags || [])}
            >
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={(post as any).slug ?? post.id.replace(/\.[^/.]+$/, "")}
                tags={post.data.tags}
                body={post.body}
              />
            </div>
          ))}
        </div>
      </main>

      <!-- Compact Sidebar Pillar Palette (Spans 1 Column, Sticky) -->
      <aside class="lg:col-span-1 lg:sticky lg:top-24">
        <div class="p-5 rounded-2xl bg-surface border border-white/10 glass-card space-y-4">
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <span class="text-xs font-mono text-accent uppercase tracking-wider">PILLAR PALETTE</span>
            <span class="text-[10px] font-mono text-neutral-500">FILTER</span>
          </div>

          <!-- Landing Page Aligned Category Toggles -->
          <div class="flex flex-col gap-2" id="pillar-filter-group">
            {categories.map((cat) => (
              <button
                data-category={cat.key}
                data-tags={JSON.stringify(cat.tags || [])}
                class={`pillar-btn w-full text-left px-3.5 py-2.5 rounded-xl border font-mono text-xs flex justify-between items-center transition-all ${
                  cat.key === 'all'
                    ? cat.colorClass + ' active-pillar'
                    : 'border-white/10 bg-white/5 text-neutral-400 hover:border-white/20 hover:text-white'
                }`}
                data-active-class={cat.colorClass}
              >
                <span class="truncate pr-2">{cat.label}</span>
                <span class={`w-2 h-2 rounded-full shrink-0 ${cat.dotColor}`}></span>
              </button>
            ))}
          </div>

          <!-- Palette Legend -->
          <div class="pt-3 border-t border-white/5 text-[11px] font-mono text-neutral-500 space-y-1.5">
            <p class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span> Platform & Infrastructure
            </p>
            <p class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Quality & Automation
            </p>
            <p class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span> Engineering Leadership
            </p>
          </div>
        </div>
      </aside>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const buttons = document.querySelectorAll('.pillar-btn');
      const posts = document.querySelectorAll('.blog-card-item');
      const label = document.getElementById('active-category-label');

      if (!buttons.length || !posts.length) return;

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const categoryKey = btn.getAttribute('data-category');
          const targetTags = JSON.parse(btn.getAttribute('data-tags') || '[]');
          const activeClass = btn.getAttribute('data-active-class') || '';

          // Reset all buttons to default inactive state
          buttons.forEach((b) => {
            const bClass = b.getAttribute('data-active-class') || '';
            bClass.split(' ').forEach((cls) => b.classList.remove(cls));
            b.classList.add('border-white/10', 'bg-white/5', 'text-neutral-400');
          });

          // Activate selected button
          btn.classList.remove('border-white/10', 'bg-white/5', 'text-neutral-400');
          activeClass.split(' ').forEach((cls) => btn.classList.add(cls));

          let visibleCount = 0;

          // Filter articles based on category mapping
          posts.forEach((post) => {
            const postTags = JSON.parse(post.getAttribute('data-tags') || '[]').map((t) => t.toLowerCase());
            
            if (categoryKey === 'all') {
              post.style.display = 'block';
              visibleCount++;
            } else {
              const hasMatch = postTags.some((tag) => targetTags.includes(tag));
              
              if (hasMatch) {
                post.style.display = 'block';
                visibleCount++;
              } else {
                post.style.display = 'none';
              }
            }
          });

          if (label) {
            const categoryLabel = btn.querySelector('span')?.textContent || 'ALL WRITING';
            label.textContent = `CATEGORY: ${categoryLabel.toUpperCase()} (${visibleCount})`;
          }
        });
      });
    });
  </script>
</Base>