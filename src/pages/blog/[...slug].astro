---
import Base from '../../layouts/Base.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CodeBlockScript from '../../components/CodeBlockScript.astro';
import { getCollection, render } from 'astro:content';
import ReactionButton from '../../components/ReactionButton.astro';
import { env } from "cloudflare:workers"


export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(p => !p.data.draft)
    .map(post => {
      // Derive the slug here so it's explicitly passed in props
      const postSlug = post.slug ?? post.id.replace(/\.[^/.]+$/, "");
      return {
        params: { slug: postSlug },
        props: { post, slug: postSlug },
      };
    });
}

const { post, slug } = Astro.props;

// headings is returned natively by render()
const { Content, headings } = await render(post);
const ogImageUrl = `/og/${slug}.png`;
---

<Base title={post.data.title} description={post.data.description} image={ogImageUrl}>
  <ProgressBar />

  <div class="article-layout">
    <article class="post-content">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="post-date">{post.data.pubDate.toDateString()}</p>
      </header>

      <Content />
      <ReactionButton slug={slug} />
    </article>

    <aside class="sidebar">
      <div class="sticky-wrapper">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </div>

  <CodeBlockScript />
</Base>

<style>
  .post-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--surface-border);
    padding-bottom: 1.5rem;
  }

  .post-header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }

  .post-date {
    font-family: var(--font-mono);
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0;
  }

  /* 1. Mobile Layout (< 1024px) */
  .article-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: 100%;
  }

  .sidebar,
  .sticky-wrapper {
    position: relative;
    top: auto;
    height: auto;
    max-height: none;
    overflow: visible;
  }

  /* 2. Desktop Layout (>= 1024px) - Non-sticky 2-Column Grid */
  @media (min-width: 1024px) {
    .article-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 2.5rem;
      align-items: start;
    }
  }

  /* Force child TOC component overrides if needed */
  .sidebar :global(nav),
  .sidebar :global(.toc),
  .sidebar :global(aside) {
    position: relative !important;
    top: auto !important;
  }
</style>