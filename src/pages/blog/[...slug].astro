---
import Base from '../../layouts/Base.astro';
import ProgressBar from '../../components/ProgressBar.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import CodeBlockScript from '../../components/CodeBlockScript.astro';
import ReactionButton from '../../components/ReactionButton.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(p => !p.data.draft)
    .map(post => {
      const postSlug = post.slug ?? post.id.replace(/\.[^/.]+$/, "");
      return {
        params: { slug: postSlug },
        props: { post, slug: postSlug },
      };
    });
}

const { post, slug } = Astro.props;
const { Content, headings } = await render(post);
const ogImageUrl = `/og/${slug}.png`;
---

<Base title={post.data.title} description={post.data.description} image={ogImageUrl}>
  <ProgressBar />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12 items-start">
      
      <!-- Article Content Body -->
      <article class="lg:col-span-3 space-y-8">
        <header class="p-8 rounded-3xl bg-surface border border-white/10 glass-card space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-neutral-400">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            <span>ENGINEERING JOURNAL</span>
          </div>

          <h1 class="text-3xl md:text-5xl font-bold text-white tracking-tight">
            {post.data.title}
          </h1>

          <p class="text-lg text-neutral-300 leading-relaxed">
            {post.data.description}
          </p>

          {post.data.tags && post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-4 border-t border-white/10">
              {post.data.tags.map((tag: string) => (
                <span class="px-3 py-1 rounded-full border border-white/10 bg-white/5 font-mono text-xs text-accent">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <div class="p-8 md:p-12 rounded-3xl bg-surface border border-white/10 prose prose-invert max-w-none prose-headings:font-bold prose-a:text-accent">
          <Content />
        </div>

        <div class="pt-6">
          <ReactionButton slug={slug} />
        </div>
      </article>

      <!-- Sticky Table of Contents Sidebar -->
      <aside class="lg:col-span-1 lg:sticky lg:top-24 space-y-6">
        <div class="p-6 rounded-3xl bg-surface border border-white/10 glass-card">
          <TableOfContents headings={headings} />
        </div>
      </aside>

    </div>
  </div>

  <CodeBlockScript />
</Base>