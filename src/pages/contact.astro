---
import PageLayout from '../layouts/PageLayout.astro';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
const siteKey = PUBLIC_TURNSTILE_SITE_KEY;
---

<PageLayout title="Contact">
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div class="max-w-xl mx-auto">
    <form id="contact-form" class="space-y-4">
      <div>
        <label for="name" class="block text-sm font-medium mb-1">Name</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          required 
          class="w-full bg-white/5 border border-white/10 rounded-lg p-3 text-base text-white focus:outline-none focus:border-accent" 
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium mb-1">Email</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          class="w-full bg-white/5 border border-white/10 rounded-lg p-3 text-base text-white focus:outline-none focus:border-accent" 
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium mb-1">Message</label>
        <textarea 
          id="message" 
          name="message" 
          rows="4" 
          required 
          class="w-full bg-white/5 border border-white/10 rounded-lg p-3 text-base text-white focus:outline-none focus:border-accent"
        ></textarea>
      </div>

      <div class="cf-turnstile overflow-hidden" data-sitekey={siteKey} data-theme="dark"></div>

      <button 
        type="submit" 
        id="submit-btn" 
        class="w-full sm:w-auto bg-white text-black hover:bg-neutral-200 font-semibold px-6 py-3 rounded-lg transition-all"
      >
        Send Message
      </button>
    </form>
  </div>
</PageLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    if (!payload['cf-turnstile-response']) {
      alert('Please complete the CAPTCHA verification.');
      return;
    }

    const res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (res.ok) {
      alert('Message sent successfully!');
      form.reset();
    } else {
      alert('Verification failed or server error occurred.');
    }
  });
</script>k