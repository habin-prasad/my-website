---
import PageLayout from '../layouts/PageLayout.astro';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
const siteKey = PUBLIC_TURNSTILE_SITE_KEY;
---

<PageLayout title="Contact">
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <div class="mx-auto max-w-xl">
    <form id="contact-form" class="space-y-4">
      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-neutral-200">Name</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          required 
          class="w-full rounded-lg border border-white/10 bg-white/5 p-3 text-base text-white outline-none transition-colors focus:border-accent" 
        />
      </div>

      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-neutral-200">Email</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          class="w-full rounded-lg border border-white/10 bg-white/5 p-3 text-base text-white outline-none transition-colors focus:border-accent" 
        />
      </div>

      <div>
        <label for="message" class="mb-1 block text-sm font-medium text-neutral-200">Message</label>
        <textarea 
          id="message" 
          name="message" 
          rows="4" 
          required 
          class="w-full rounded-lg border border-white/10 bg-white/5 p-3 text-base text-white outline-none transition-colors focus:border-accent"
        ></textarea>
      </div>

      <div class="cf-turnstile overflow-hidden" data-sitekey={siteKey} data-theme="dark"></div>

      <button 
        type="submit" 
        id="submit-btn" 
        class="w-full rounded-lg bg-accent px-6 py-3 font-semibold text-black transition-colors hover:bg-accent-hover sm:w-auto disabled:cursor-not-allowed disabled:opacity-60"
      >
        Send Message
      </button>
    </form>
  </div>
</PageLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form && !form.dataset.handlerAttached) {
    form.dataset.handlerAttached = 'true';
    form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const payload = Object.fromEntries(formData.entries());

    if (!payload['cf-turnstile-response']) {
      alert('Please complete the CAPTCHA verification.');
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('[type="submit"]');
    if (button) button.disabled = true;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('Request failed');
      alert('Message sent successfully!');
      form.reset();
    } catch {
      alert('Message could not be sent. Please try again later.');
    } finally {
      if (button) button.disabled = false;
    }
    });
  }
</script>
