---
---
<header class="nav-header">
  <div class="nav-container">
    <a href="/" class="brand">habin<span class="dot">.quality</span></a>
    
    <nav class="nav-links">
      <a href="/about">About</a>
      <a href="/projects">Projects</a>
      <a href="/blog">Blog</a>
      
      <button id="search-trigger-btn" type="button" aria-label="Search" class="search-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="search-text">Search</span>
        <kbd class="hidden sm:inline-block">⌘K</kbd>
      </button>
    </nav>
  </div>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    backdrop-filter: blur(12px);
    background: rgba(9, 13, 22, 0.85);
    border-bottom: 1px solid var(--surface-border);
    z-index: 100;
  }
  .nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  @media (min-width: 640px) {
    .nav-container {
      padding: 1rem 1.5rem;
    }
  }
  .brand { font-weight: 700; font-size: 1rem; text-decoration: none; color: var(--text); }
  @media (min-width: 640px) {
    .brand { font-size: 1.1rem; }
  }
  .dot { color: var(--accent); }
  .nav-links { display: flex; gap: 0.75rem; align-items: center; }
  @media (min-width: 640px) {
    .nav-links { gap: 1.25rem; }
  }
  .nav-links a { color: var(--muted); text-decoration: none; font-size: 0.875rem; transition: color 0.2s; }
  @media (min-width: 640px) {
    .nav-links a { font-size: 0.95rem; }
  }
  .nav-links a:hover { color: var(--text); }
  
  .search-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    color: var(--muted);
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s ease;
    touch-action: manipulation;
  }
  @media (min-width: 640px) {
    .search-btn {
      padding: 0.4rem 0.75rem;
      gap: 0.5rem;
    }
  }
  .search-text {
    display: none;
  }
  @media (min-width: 640px) {
    .search-text {
      display: inline;
    }
  }
  .search-btn:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  kbd {
    background: var(--bg);
    border: 1px solid var(--surface-border);
    border-radius: 4px;
    padding: 0.1rem 0.3rem;
    font-size: 0.7rem;
    font-family: var(--font-mono);
  }
</style>