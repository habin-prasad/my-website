---
// src/components/Nav.astro
---
<header class="nav-header">
  <div class="nav-container">
    <a href="/" class="brand">habin<span class="dot">.dev</span></a>
    
    <nav class="nav-links">
      <a href="/about">About</a>
      <a href="/projects">Projects</a>
      <a href="/blog">Blog</a>
      
      <!-- Pagefind 1.5.0 Modal Trigger Button -->
      <pagefind-modal-trigger class="search-btn">
        <button type="button" aria-label="Search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <span class="search-text">Search</span>
          <kbd>⌘K</kbd>
        </button>
      </pagefind-modal-trigger>
    </nav>
  </div>
</header>

<style>
  .nav-header {
    position: sticky;
    top: 0;
    backdrop-filter: blur(12px);
    background: rgba(9, 13, 22, 0.8);
    border-bottom: 1px solid var(--surface-border);
    z-index: 100;
  }
  .nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand { font-weight: 700; font-size: 1.1rem; text-decoration: none; color: var(--text); }
  .dot { color: var(--accent); }
  .nav-links { display: flex; gap: 1.25rem; align-items: center; }
  .nav-links a { color: var(--muted); text-decoration: none; font-size: 0.95rem; transition: color 0.2s; }
  .nav-links a:hover { color: var(--text); }
  
  .search-btn button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    color: var(--muted);
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .search-btn button:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  kbd {
    background: var(--bg);
    border: 1px solid var(--surface-border);
    border-radius: 4px;
    padding: 0.1rem 0.3rem;
    font-size: 0.7rem;
    font-family: var(--font-mono);
  }
</style>