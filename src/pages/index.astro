---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import ExecutiveHero from '../components/ExecutiveHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// Fetch top featured case studies
const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .slice(0, 2);
---

<Base title="Head of Automation & Tech Lead">
  <div class="container-wide">
    <!-- Executive Hero Section -->
    <ExecutiveHero />

    <!-- Featured Case Studies Showcase -->
    <section class="home-section">
      <div class="section-header">
        <h2>Featured Architecture & Platforms</h2>
        <a href="/projects" class="view-all-link">View All Systems →</a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .home-section {
    margin-top: 4rem;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .section-header h2 {
    font-size: 1.5rem;
    margin: 0;
  }
  .view-all-link {
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 1.5rem;
  }
</style>