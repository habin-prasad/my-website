---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import KineticHero from '../components/KineticHero.astro';
import BentoGrid from '../components/BentoGrid.astro';

const projects = (await getCollection('projects')).filter((p) => !p.data.draft) || [];

const blogPosts = (await getCollection('blog')).filter((p) => !p.data.draft) || [];

// Map actual project domains and metrics to KineticHero options
const domainMap: Record<string, { label: string; text: string; desc: string }> = {
  'Platform & Infrastructure': {
    label: 'Scale',
    text: 'scalable infrastructure.',
    desc: "When traffic spikes, systems shouldn't sweat. I build distributed, fault-tolerant architectures that stay up when it matters."
  },
  'Quality & Automation': {
    label: 'Quality',
    text: 'automation-first quality.',
    desc: 'Manual testing slows teams down. I build autonomous quality platforms that catch issues before they reach production.'
  },
  'Engineering Leadership': {
    label: 'Leadership',
    text: 'team-scale engineering.',
    desc: 'Great systems start with great teams. I lead engineering organizations to build resilient, high-impact platforms.'
  },
  'Distributed Systems': {
    label: 'Scale',
    text: 'distributed systems.',
    desc: 'Building resilient, high-throughput distributed architectures that scale globally.'
  },
  'Developer Experience': {
    label: 'DX',
    text: 'developer productivity.',
    desc: 'Engineers ship faster with the right tools. I build developer platforms that eliminate friction and accelerate delivery.'
  }
};

// Extract unique domains present in actual project content
const projectDomains = [...new Set(projects.map((p) => p.data.domain))];

// Build options array dynamically based on available content
const heroOptions = projectDomains.map((domain) => {
  const config = domainMap[domain] || {
    label: domain,
    text: `${domain.toLowerCase()} solutions.`,
    desc: `Architecting robust systems and engineering workflows specialized in ${domain}.`
  };

  return {
    key: domain,
    label: config.label,
    text: config.text,
    desc: config.desc
  };
});

// Fallback if collections are empty
if (heroOptions.length === 0) {
  heroOptions.push({
    key: 'Platform & Infrastructure',
    label: 'Scale',
    text: 'scalable infrastructure.',
    desc: "When traffic spikes, systems shouldn't sweat. I build distributed architectures that stay up when it matters."
  });
}

// Tech stack aggregation
const allTechnologies = [...new Set(projects.flatMap((p) => p.data.technologies || []))];

// Primary metric aggregation — normalize string metrics to MetricItem objects
const rawMetric = projects.flatMap((p) => p.data.metrics || [])[0];
const primaryMetric = rawMetric
  ? typeof rawMetric === 'string'
    ? { value: rawMetric, label: 'Impact Metric', description: 'Key performance indicator.' }
    : rawMetric
  : {
    value: '-400ms',
    label: 'p99 API Latency',
    description: 'Reduction in response time via edge Redis caching layer.'
  };
---

<Base title="Head of Automation & Tech Lead">
  <div class="container-wide">
    <KineticHero options={heroOptions} />
    <BentoGrid 
      projects={projects} 
      posts={blogPosts}
      technologies={allTechnologies}
      metric={primaryMetric}
    />
  </div>
</Base>