---
import { getCollection, getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { id } = Astro.params;
let project = Astro.props.project;

if (!project && id) {
  project = await getEntry('projects', id);
}

if (!project) {
  return Astro.redirect('/404');
}

const { data } = project;
const { Content } = await render(project);

// Fetch blog posts related to this project
const allBlogs = await getCollection('blog');
const relatedBlogs = allBlogs.filter((post) => {
  const matchesProject = post.data.projectId === project.id;
  const sharesTags = post.data.tags?.some((tag: string) =>
    data.technologies?.includes(tag)
  );
  return matchesProject || sharesTags;
});
---

<PageLayout title={data.title} subtitle={`${data.role || 'Tech Lead'} · ${data.period || 'Active'}`}>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
    
    <!-- Hero Header -->
    <header class="p-8 md:p-12 rounded-3xl bg-surface border border-white/10 glass-card space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
        <span class="px-3 py-1 rounded-full border border-accent/30 bg-accent/10 text-accent font-bold uppercase tracking-wider">
          {data.domain}
        </span>
        {data.period && <span class="text-neutral-400">{data.period}</span>}
      </div>
      
      <p class="text-xl md:text-2xl text-neutral-200 leading-relaxed font-light">
        {data.summary}
      </p>

      <!-- Key Metrics Highlight -->
      {data.metrics && data.metrics.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 border-t border-white/10">
          {data.metrics.map((metric: any) => (
            <div class="p-4 rounded-2xl bg-white/5 border border-white/5">
              <span class="text-xs font-mono text-neutral-400 uppercase block mb-1">
                {typeof metric === 'string' ? 'Impact Metric' : metric.label}
              </span>
              <span class="text-2xl md:text-3xl font-bold text-white tracking-tight">
                {typeof metric === 'string' ? metric : metric.value}
              </span>
              {typeof metric !== 'string' && metric.description && (
                <p class="text-xs text-neutral-400 mt-1">{metric.description}</p>
              )}
            </div>
          ))}
        </div>
      )}

      <!-- Tech Stack Badges -->
      {data.technologies && data.technologies.length > 0 && (
        <div class="pt-4 border-t border-white/10">
          <span class="text-xs font-mono text-neutral-500 uppercase block mb-3">SYSTEM TECH STACK</span>
          <div class="flex flex-wrap gap-2">
            {data.technologies.map((tech: string) => (
              <span class="px-3 py-1 rounded-full border border-white/10 bg-white/5 font-mono text-xs text-neutral-300">
                {tech}
              </span>
            ))}
          </div>
        </div>
      )}
    </header>

    <!-- Post Content Container -->
    <div class="p-8 md:p-12 rounded-3xl bg-surface border border-white/10 prose prose-invert max-w-none prose-headings:font-bold prose-a:text-accent">
      <Content />
    </div>

    <!-- Related Blog Posts Section -->
    {relatedBlogs.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-2xl font-bold text-white tracking-tight flex items-center gap-3">
          <span class="text-accent font-mono text-sm">//</span> Related Writing & Notes
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {relatedBlogs.map((blog) => (
            <a 
              href={`/blog/${blog.slug ?? blog.id.replace(/\.[^/.]+$/, "")}`} 
              class="group p-6 rounded-2xl bg-surface border border-white/10 hover:border-accent/50 transition-all flex flex-col justify-between"
            >
              <div>
                <h3 class="text-lg font-bold text-white group-hover:text-accent transition-colors mb-2">
                  {blog.data.title}
                </h3>
                <p class="text-sm text-neutral-400 line-clamp-2 mb-4">
                  {blog.data.description}
                </p>
              </div>
              <span class="text-xs font-mono text-accent flex items-center gap-1">
                Read Article →
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</PageLayout>