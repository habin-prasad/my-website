---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import HorizontalCarousel from '../../components/HorizontalCarousel.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft) || [];
const featuredProjects = allProjects.filter((p) => p?.data?.featured === true);
const otherProjects = allProjects.filter((p) => !p?.data?.featured);
const domains = [...new Set(allProjects.map((p) => p.data.domain).filter(Boolean))];
---

<PageLayout 
  title="Engineering Leadership & Systems" 
  subtitle="Architectural case studies, infrastructure platforms, and automated developer tooling."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-8 space-y-8 md:space-y-12">
    
    <!-- Domain Filter Bar (Mobile Sticky Horizontal Scroll, Desktop Glass Card) -->
    {domains.length > 0 && (
      <div class="sticky top-0 z-30 -mx-4 px-4 py-3 bg-background/90 backdrop-blur-md border-b border-white/10 sm:relative sm:top-auto sm:mx-0 sm:p-6 sm:rounded-3xl sm:bg-surface sm:border sm:glass-card">
        <span class="text-[10px] sm:text-xs font-mono text-accent uppercase tracking-wider block mb-2">FILTER BY DOMAIN</span>
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar sm:flex-wrap" id="project-domain-filters">
          <button data-domain="all" class="project-filter-btn shrink-0 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full border border-accent bg-accent/10 text-accent font-mono text-xs transition-all whitespace-nowrap">
            [ All Systems ]
          </button>
          {domains.map((domain) => (
            <button data-domain={domain} class="project-filter-btn shrink-0 px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full border border-white/10 bg-white/5 text-neutral-400 font-mono text-xs transition-all hover:text-white whitespace-nowrap">
              {domain}
            </button>
          ))}
        </div>
      </div>
    )}

    {/* Featured Projects */}
    {featuredProjects.length > 0 && (
      <section class="space-y-4 md:space-y-6 project-group" data-group="featured">
        <h2 class="text-lg md:text-xl font-bold text-white font-mono flex items-center gap-2">
          <span class="text-accent">01 /</span> FEATURED CASE STUDIES
        </h2>

        <!-- Mobile Snap Carousel (< md) -->
        <div class="block md:hidden">
          <HorizontalCarousel title="Featured Projects">
            {featuredProjects.map((project) => (
              <div class="project-item snap-center shrink-0 w-[82vw]" data-domain={project.data.domain}>
                <ProjectCard project={project} />
              </div>
            ))}
          </HorizontalCarousel>
        </div>

        <!-- Desktop Grid (≥ md) -->
        <div class="hidden md:grid md:grid-cols-2 gap-6">
          {featuredProjects.map((project) => (
            <div class="project-item" data-domain={project.data.domain}>
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Other Projects */}
    {otherProjects.length > 0 && (
      <section class="space-y-4 md:space-y-6 project-group" data-group="other">
        <h2 class="text-lg md:text-xl font-bold text-white font-mono flex items-center gap-2">
          <span class="text-accent">02 /</span> ADDITIONAL INITIATIVES
        </h2>

        <!-- Mobile Snap Carousel (< md) -->
        <div class="block md:hidden">
          <HorizontalCarousel title="Additional Projects">
            {otherProjects.map((project) => (
              <div class="project-item snap-center shrink-0 w-[80vw]" data-domain={project.data.domain}>
                <ProjectCard project={project} />
              </div>
            ))}
          </HorizontalCarousel>
        </div>

        <!-- Desktop Grid (≥ md) -->
        <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherProjects.map((project) => (
            <div class="project-item" data-domain={project.data.domain}>
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </section>
    )}

    {allProjects.length === 0 && (
      <p class="text-neutral-500 font-mono text-sm italic">No projects found in content collection.</p>
    )}
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const buttons = document.querySelectorAll('.project-filter-btn');
      const items = document.querySelectorAll('.project-item');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedDomain = btn.getAttribute('data-domain');

          buttons.forEach((b) => {
            b.classList.remove('border-accent', 'bg-accent/10', 'text-accent');
            b.classList.add('border-white/10', 'bg-white/5', 'text-neutral-400');
          });

          btn.classList.remove('border-white/10', 'bg-white/5', 'text-neutral-400');
          btn.classList.add('border-accent', 'bg-accent/10', 'text-accent');

          items.forEach((item) => {
            const itemDomain = item.getAttribute('data-domain');
            if (selectedDomain === 'all' || itemDomain === selectedDomain) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</PageLayout>