---
interface Props {
  slug?: string;
}
const { slug = 'default' } = Astro.props;
---

<div class="reaction-container inline-flex items-center gap-3 px-4 py-2 rounded-full bg-surface border border-white/10 glass-card" data-slug={slug}>
  <button id="clap-btn" class="flex items-center gap-2 text-sm font-mono font-medium text-neutral-300 hover:text-accent active:scale-95 transition-all" aria-label="Like this post">
    <svg class="clap-icon w-5 h-5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
    </svg>
    <span>Applaud</span>
  </button>
  <div class="px-2.5 py-0.5 rounded-full bg-accent/10 border border-accent/20 font-mono text-xs text-accent">
    <span id="clap-count">--</span>
  </div>
</div>

<script>
  function setupReactionButton() {
    const container = document.querySelector('.reaction-container') as HTMLElement;
    if (!container) return;

    const slug = container.dataset.slug;
    const btn = document.getElementById('clap-btn')!;
    const countEl = document.getElementById('clap-count')!;

    if (!slug) return;

    async function loadReactions() {
      try {
        const res = await fetch(`/api/react?slug=${encodeURIComponent(slug as string)}`);
        if (res.ok) {
          const data = await res.json();
          countEl.textContent = data.count.toString();
        } else {
          countEl.textContent = '0';
        }
      } catch (err) {
        countEl.textContent = '0';
      }
    }

    async function handleClap() {
      const currentCount = parseInt(countEl.textContent || '0', 10);
      countEl.textContent = (currentCount + 1).toString();
      btn.classList.add('text-accent');

      try {
        const res = await fetch('/api/react', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug }),
        });

        if (res.ok) {
          const data = await res.json();
          countEl.textContent = data.count.toString();
        }
      } catch (err) {
        countEl.textContent = currentCount.toString();
        btn.classList.remove('text-accent');
      }

      setTimeout(() => btn.classList.remove('text-accent'), 300);
    }

    btn.addEventListener('click', handleClap);
    loadReactions();
  }

  document.addEventListener('DOMContentLoaded', setupReactionButton);
  document.addEventListener('astro:page-load', setupReactionButton);
</script>