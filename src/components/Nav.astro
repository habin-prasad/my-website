---
import SearchTrigger from './SearchTrigger.astro';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 w-full border-b border-white/10 bg-[#09090b]/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="text-base font-mono font-bold tracking-tight text-white transition-colors hover:text-accent">
      habin<span class="font-mono text-accent">.quality</span>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-6 text-sm font-mono md:flex">
      <a href="/about" aria-current={currentPath.startsWith('/about') ? 'page' : undefined} class:list={['transition-colors hover:text-accent', currentPath.startsWith('/about') ? 'font-bold text-accent' : 'text-neutral-400']}>About</a>
      <a href="/blog" aria-current={currentPath.startsWith('/blog') ? 'page' : undefined} class:list={['transition-colors hover:text-accent', currentPath.startsWith('/blog') ? 'font-bold text-accent' : 'text-neutral-400']}>Blog</a>
      <a href="/projects" aria-current={currentPath.startsWith('/projects') ? 'page' : undefined} class:list={['transition-colors hover:text-accent', currentPath.startsWith('/projects') ? 'font-bold text-accent' : 'text-neutral-400']}>Projects</a>
      <SearchTrigger />
    </nav>

    <div class="flex items-center md:hidden">
      <SearchTrigger />
    </div>
  </div>
</header>
