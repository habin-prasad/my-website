---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filteredHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{filteredHeadings.length > 0 && (
  <nav class="space-y-3" aria-label="Table of Contents">
    <div class="text-xs font-mono font-bold text-neutral-200 uppercase tracking-wider">
      On This Page
    </div>
    <ul class="space-y-2 text-xs font-mono">
      {filteredHeadings.map(h => (
        <li class={h.depth === 3 ? "pl-3 border-l border-white/10" : ""}>
          <a 
            href={`#${h.slug}`}
            class="toc-link block text-neutral-400 hover:text-accent transition-colors leading-relaxed truncate"
            data-slug={h.slug}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  function initTocHighlight() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        const tocLink = document.querySelector(`.toc-link[data-slug="${id}"]`);

        if (entry.isIntersecting && tocLink) {
          document.querySelectorAll('.toc-link').forEach(a => {
            a.classList.remove('text-accent', 'font-bold');
            a.classList.add('text-neutral-400');
          });
          tocLink.classList.add('text-accent', 'font-bold');
          tocLink.classList.remove('text-neutral-400');
        }
      });
    }, { rootMargin: '-80px 0px -60% 0px' });

    document.querySelectorAll('article h2, article h3').forEach(heading => {
      observer.observe(heading);
    });
  }

  document.addEventListener('DOMContentLoaded', initTocHighlight);
  document.addEventListener('astro:page-load', initTocHighlight);
</script>