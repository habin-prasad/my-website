---

<button 
  id="search-trigger-btn" 
  class="flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 px-3 py-1.5 rounded-xl text-neutral-400 hover:text-white transition-all text-xs font-mono active:scale-95 min-h-[36px] pointer-events-auto touch-manipulation"
  aria-label="Search site"
  type="button"
>
  <svg class="pointer-events-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <span class="hidden sm:inline pointer-events-none">Search</span>
  <kbd class="hidden sm:inline-block bg-white/10 px-1.5 py-0.5 rounded text-[10px] text-neutral-300 pointer-events-none">⌘K</kbd>
</button>

<script>
  function setupTrigger() {
    const btn = document.getElementById('search-trigger-btn');
    if (!btn) return;

    const triggerOpen = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      window.dispatchEvent(new CustomEvent('open-search'));
    };

    btn.addEventListener('click', triggerOpen);
  }

  document.addEventListener('DOMContentLoaded', setupTrigger);
  document.addEventListener('astro:page-load', setupTrigger);
</script>