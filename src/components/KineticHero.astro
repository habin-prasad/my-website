---
export interface HeroOption {
  key: string;
  label: string;
  text: string;
  desc: string;
}

interface Props {
  options: HeroOption[];
}

const { options = [] } = Astro.props;
const initialOption = options[0];
---

<section class="relative pt-20 pb-12 sm:pt-32 sm:pb-20 lg:pt-40 lg:pb-28 overflow-hidden">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[300px] sm:w-[600px] h-[300px] bg-accent/20 blur-[100px] rounded-full pointer-events-none opacity-40"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6 sm:space-y-8">
    <h1 class="text-3xl sm:text-5xl md:text-7xl font-bold tracking-tight text-white leading-tight">
      You are here because you need <br class="hidden sm:block" />
      <span id="hero-dynamic-text" class="text-accent transition-opacity duration-200">
        {initialOption?.text || 'scalable infrastructure.'}
      </span>
    </h1>

    <!-- Mobile Touch Horizontal Scroll Toggles -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap" id="hero-toggles">
      {options.map((option, idx) => (
        <button 
          data-key={option.key}
          data-text={option.text}
          data-desc={option.desc}
          class={`hero-btn shrink-0 px-4 py-2 rounded-full font-mono text-xs font-medium transition-all active:scale-95 ${
            idx === 0 
              ? 'border border-accent bg-accent/10 text-accent font-bold' 
              : 'border border-white/10 bg-white/5 text-neutral-400 hover:text-white'
          }`}
        >
          {option.label}
        </button>
      ))}
    </div>

    <p id="hero-description" class="text-base sm:text-xl md:text-2xl text-neutral-400 max-w-2xl leading-relaxed transition-opacity duration-200">
      {initialOption?.desc || "When traffic spikes, systems shouldn't sweat."}
    </p>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll('.hero-btn');
    const dynamicText = document.getElementById('hero-dynamic-text');
    const description = document.getElementById('hero-description');

    if (!buttons.length || !dynamicText || !description) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const targetBtn = e.currentTarget as HTMLButtonElement;
        const selectedKey = targetBtn.dataset.key;
        const text = targetBtn.dataset.text;
        const desc = targetBtn.dataset.desc;

        if (!selectedKey) return;

        buttons.forEach((b) => {
          b.classList.remove('border-accent', 'bg-accent/10', 'text-accent', 'font-bold');
          b.classList.add('border-white/10', 'bg-white/5', 'text-neutral-400');
        });

        targetBtn.classList.remove('border-white/10', 'bg-white/5', 'text-neutral-400');
        targetBtn.classList.add('border-accent', 'bg-accent/10', 'text-accent', 'font-bold');

        dynamicText.style.opacity = '0';
        description.style.opacity = '0';

        setTimeout(() => {
          if (text) dynamicText.textContent = text;
          if (desc) description.textContent = desc;

          dynamicText.style.opacity = '1';
          description.style.opacity = '1';
        }, 200);

        window.dispatchEvent(
          new CustomEvent('hero-domain-change', {
            detail: { domain: selectedKey }
          })
        );
      });
    });
  });
</script>