<section class="space-y-8 sm:space-y-12 py-6 sm:py-10">
  <div class="space-y-3 sm:space-y-4">
    <span class="inline-block px-3 py-1 rounded-full border border-accent/30 bg-accent/10 text-accent font-mono text-xs font-bold uppercase tracking-wider">
      Tech Lead • Head of Software Automation
    </span>
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-white tracking-tight leading-tight">
      Scaling quality engineering infrastructure & autonomous test platforms.
    </h1>
    <p class="text-base sm:text-lg md:text-xl text-neutral-300 max-w-3xl leading-relaxed font-light">
      Leading end-to-end software quality strategy, building zero-flakiness test architectures from scratch, and aligning engineering outcomes directly with executive leadership.
    </p>
  </div>

  <!-- Executive Impact Strip -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-5 sm:p-6 rounded-2xl bg-surface border border-white/10 glass-card">
    <div class="flex flex-col items-center justify-center p-3 text-center sm:border-r sm:border-white/10">
      <span class="text-3xl sm:text-4xl font-bold text-accent tracking-tight">88%</span>
      <span class="text-xs font-mono text-neutral-400 mt-1 uppercase">Cycle Time Reduction</span>
    </div>
    <div class="flex flex-col items-center justify-center p-3 text-center sm:border-r sm:border-white/10">
      <span class="text-3xl sm:text-4xl font-bold text-accent tracking-tight">12+</span>
      <span class="text-xs font-mono text-neutral-400 mt-1 uppercase">Squads Aligned</span>
    </div>
    <div class="flex flex-col items-center justify-center p-3 text-center">
      <span class="text-3xl sm:text-4xl font-bold text-accent tracking-tight">0-to-1</span>
      <span class="text-xs font-mono text-neutral-400 mt-1 uppercase">Platforms Built</span>
    </div>
  </div>

  <!-- Competency Pillars -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="p-5 rounded-2xl bg-white/5 border border-white/10 space-y-2">
      <h3 class="text-base font-bold text-white">Strategic Leadership</h3>
      <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
        Team scaling, quality strategy, cross-functional alignment, and engineering mentorship.
      </p>
    </div>
    <div class="p-5 rounded-2xl bg-white/5 border border-white/10 space-y-2">
      <h3 class="text-base font-bold text-white">Platform & Infrastructure</h3>
      <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
        From-scratch autonomous execution engines, CI/CD orchestration, and dynamic parallel scheduling.
      </p>
    </div>
    <div class="p-5 rounded-2xl bg-white/5 border border-white/10 space-y-2">
      <h3 class="text-base font-bold text-white">Quality Engineering</h3>
      <p class="text-xs sm:text-sm text-neutral-400 leading-relaxed">
        Performance, API, E2E automation, deterministic state management, and chaos testing.
      </p>
    </div>
  </div>
</section>