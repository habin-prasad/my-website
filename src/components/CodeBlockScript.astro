<script>
  function initCopyButtons() {
    const codeBlocks = document.querySelectorAll('article pre, .prose pre');

    codeBlocks.forEach((block) => {
      if (block.querySelector('.copy-code-btn')) return;

      // Ensure block is relative container
      (block as HTMLElement).style.position = 'relative';

      const copyBtn = document.createElement('button');
      copyBtn.className = 'copy-code-btn absolute top-2 right-2 px-2 py-1 rounded bg-white/10 hover:bg-white/20 text-white font-mono text-[11px] flex items-center gap-1.5 transition-all border border-white/10 opacity-80 hover:opacity-100 active:scale-95';
      copyBtn.setAttribute('aria-label', 'Copy code to clipboard');
      copyBtn.innerHTML = `
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
        <span>Copy</span>
      `;

      block.appendChild(copyBtn);

      copyBtn.addEventListener('click', async () => {
        const code = block.querySelector('code');
        const textToCopy = code ? (code as HTMLElement).innerText : (block as HTMLElement).innerText;

        try {
          await navigator.clipboard.writeText(textToCopy);
          copyBtn.classList.add('bg-accent/20', 'text-accent', 'border-accent/30');
          copyBtn.querySelector('span')!.innerText = 'Copied!';

          setTimeout(() => {
            copyBtn.classList.remove('bg-accent/20', 'text-accent', 'border-accent/30');
            copyBtn.querySelector('span')!.innerText = 'Copy';
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initCopyButtons);
  document.addEventListener('astro:page-load', initCopyButtons);
</script>