---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
}

const { title, description, tags, href } = Astro.props;
---

<a href={href} class="glass-card project-card" target="_blank" rel="noopener noreferrer">
  <div class="card-header">
    <h3>{title}</h3>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
  </div>
  <p>{description}</p>
  <div class="tags">
    {tags.map(tag => <span class="tag">#{tag}</span>)}
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    gap: 0.75rem;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .card-header h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text);
  }
  .card-header svg {
    color: var(--muted);
    transition: transform 0.2s, color 0.2s;
  }
  .project-card:hover .card-header svg {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.925rem;
  }
  .tags {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
  }
</style>