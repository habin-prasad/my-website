---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
if (!project || !project.data) return null;

const { data } = project;
// Astro 5 glob loader uses 'id' instead of 'slug'
const projectId = project.id || (project as any).slug;
---

<div class="project-card glass-card">
  <div class="card-header">
    <span class="domain-tag">{data.domain}</span>
    <span class="period-text">{data.period}</span>
  </div>

  <h3 class="project-title">
    <a href={`/projects/${projectId}`}>{data.title}</a>
  </h3>
  
  <p class="role-subtitle">{data.role}</p>
  <p class="summary-text">{data.summary}</p>

  <div class="metrics-grid">
    {(data.metrics || []).map((metric) => (
      <div class="metric-badge">
        <span class="metric-icon">⚡</span>
        <span>{metric}</span>
      </div>
    ))}
  </div>

  <div class="tech-stack">
    {(data.technologies || []).map((tech) => (
      <span class="tech-chip">{tech}</span>
    ))}
  </div>

  <div class="card-footer">
    <a href={`/projects/${projectId}`} class="read-more-link">
      Read Case Study & Architecture →
    </a>
  </div>
</div>

<style>
  .project-card {
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--surface-border);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }
  .domain-tag {
    color: var(--accent);
    font-weight: 600;
  }
  .period-text {
    opacity: 0.6;
  }
  .project-title {
    margin: 0;
    font-size: 1.25rem;
  }
  .role-subtitle {
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.8;
    margin: 0;
  }
  .summary-text {
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.9;
    margin: 0;
  }
  .metrics-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .metric-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid var(--surface-border-accent);
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tech-chip {
    padding: 0.15rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }
  .read-more-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
</style>