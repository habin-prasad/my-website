---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
if (!project || !project.data) return null;

const { data } = project;
const projectId = project.id || (project as any).slug;
---

<div class="group p-5 sm:p-6 rounded-2xl bg-surface border border-white/10 hover:border-accent/40 transition-all flex flex-col justify-between h-full space-y-4">
  <div class="space-y-3">
    <div class="flex items-center justify-between text-xs font-mono">
      <span class="text-accent font-bold uppercase tracking-wider">{data.domain}</span>
      <span class="text-neutral-500">{data.period}</span>
    </div>

    <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-accent transition-colors">
      <a href={`/projects/${projectId}`} class="focus:outline-none">
        {data.title}
      </a>
    </h3>

    {data.role && (
      <p class="text-xs font-mono text-neutral-400 uppercase tracking-tight">{data.role}</p>
    )}

    <p class="text-xs sm:text-sm text-neutral-300 line-clamp-3 leading-relaxed">
      {data.summary}
    </p>
  </div>

  <div class="space-y-3 pt-3 border-t border-white/5">
    {data.metrics && data.metrics.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {data.metrics.map((metric: any) => (
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-accent/10 border border-accent/20 text-accent font-mono text-xs font-medium">
            <span>⚡</span>
            <span>{typeof metric === 'string' ? metric : metric.value}</span>
          </div>
        ))}
      </div>
    )}

    {data.technologies && data.technologies.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {data.technologies.map((tech: string) => (
          <span class="px-2 py-0.5 rounded bg-white/5 font-mono text-[11px] text-neutral-400">
            {tech}
          </span>
        ))}
      </div>
    )}

    <div class="pt-2">
      <a 
        href={`/projects/${projectId}`} 
        class="inline-flex items-center gap-1 text-xs font-mono font-bold text-accent hover:underline"
      >
        Read Case Study & Architecture →
      </a>
    </div>
  </div>
</div>