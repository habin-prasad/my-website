---
interface Domain {
  id: string;
  label: string;
  icon: string;
  subtitle: string;
}

const domains: Domain[] = [
  { 
    id: 'platform', 
    label: 'Platform Engine', 
    subtitle: 'High-throughput microservices & Edge APIs',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`
  },
  { 
    id: 'quality', 
    label: 'Quality System', 
    subtitle: 'Automated CI/CD & Delta UT Coverage',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 9 0 0118 0z" />`
  },
  { 
    id: 'architecture', 
    label: 'Architecture', 
    subtitle: 'Zero-trust design & Cloud Infrastructure',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
  }
];
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 md:pt-16 pb-8">
  <!-- Minimalist Mobile Status Header -->
  <div class="flex items-center gap-2 mb-6">
    <span class="relative flex h-2.5 w-2.5">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
    </span>
    <span class="text-xs font-mono text-neutral-400 uppercase tracking-widest">Available for Tech Lead Roles</span>
  </div>

  <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-white tracking-tight leading-tight mb-4">
    Engineering <span class="text-accent">Scalable Systems</span> & Automation.
  </h1>

  <p class="text-neutral-400 text-sm sm:text-base max-w-2xl mb-8">
    Specialized in high-availability backend microservices, modern edge deployment, and enterprise test engineering.
  </p>

  <!-- Horizontal Scroll Domain Pills (Mobile Snap Carousel) -->
  <div class="flex overflow-x-auto snap-x snap-mandatory gap-3 pb-2 no-scrollbar -mx-4 px-4 md:mx-0 md:px-0">
    {domains.map((dom, idx) => (
      <button
        data-domain-btn={dom.id}
        class={`domain-pill snap-center shrink-0 px-4 py-3 rounded-2xl border text-left transition-all duration-200 flex items-center gap-3 ${
          idx === 0 
            ? 'border-accent/40 bg-accent/10 text-white' 
            : 'border-white/10 bg-surface/50 text-neutral-400 hover:border-white/20'
        }`}
      >
        <div class="w-8 h-8 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center shrink-0 text-accent">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><Fragment set:html={dom.icon} /></svg>
        </div>
        <div>
          <p class="text-xs font-mono font-bold">{dom.label}</p>
          <p class="text-[10px] text-neutral-400 font-sans hidden sm:block">{dom.subtitle}</p>
        </div>
      </button>
    ))}
  </div>
</section>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const pills = document.querySelectorAll('[data-domain-btn]');
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('border-accent/40', 'bg-accent/10', 'text-white'));
        pill.classList.add('border-accent/40', 'bg-accent/10', 'text-white');
        
        const domainId = pill.getAttribute('data-domain-btn');
        window.dispatchEvent(new CustomEvent('hero-domain-change', { detail: { domain: domainId } }));
      });
    });
  });
</script>