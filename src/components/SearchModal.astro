---

<div id="search-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-start sm:items-center justify-center p-4 pt-12 sm:pt-4" style="display: none;" aria-hidden="true">
  <div class="bg-[#09090b] border border-white/15 rounded-2xl w-full max-w-xl p-5 shadow-2xl space-y-4 text-white max-h-[85vh] overflow-y-auto">
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <span class="font-mono text-xs text-accent uppercase tracking-wider font-bold">Search & Actions</span>
      <button id="close-search-btn" class="text-neutral-400 hover:text-white text-xl p-1" aria-label="Close search">&times;</button>
    </div>
    
    <!-- Pagefind Container -->
    <div id="pagefind-search" class="text-sm"></div>

    <!-- Quick Actions -->
    <div class="pt-3 border-t border-white/10 space-y-2">
      <div class="text-[10px] font-mono text-neutral-500 uppercase tracking-wider">Quick Actions</div>
      <div class="grid grid-cols-2 gap-2 text-xs font-mono">
        <a href="/" class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/10 hover:border-accent/40 text-neutral-300 hover:text-white">
          <kbd class="text-[10px] bg-white/10 px-1 rounded">/</kbd> Home
        </a>
        <a href="/blog" class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/10 hover:border-accent/40 text-neutral-300 hover:text-white">
          <kbd class="text-[10px] bg-white/10 px-1 rounded">/blog</kbd> Journal
        </a>
        <a href="/projects" class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/10 hover:border-accent/40 text-neutral-300 hover:text-white">
          <kbd class="text-[10px] bg-white/10 px-1 rounded">/projects</kbd> Projects
        </a>
        <a href="/about" class="flex items-center gap-2 p-2 rounded-lg bg-white/5 border border-white/10 hover:border-accent/40 text-neutral-300 hover:text-white">
          <kbd class="text-[10px] bg-white/10 px-1 rounded">/about</kbd> About
        </a>
      </div>
      <button id="copy-rss-action" class="w-full flex items-center justify-center gap-2 p-2 rounded-lg bg-white/5 border border-white/10 hover:border-accent/40 text-neutral-300 hover:text-white text-xs font-mono">
        <kbd class="text-[10px] bg-white/10 px-1 rounded">RSS</kbd> Copy Feed
      </button>
    </div>
  </div>
</div>

<script is:inline src="/pagefind/pagefind-ui.js"></script>

<script>
  function initSearchModal() {
    const modal = document.getElementById('search-modal');
    const closeBtn = document.getElementById('close-search-btn');
    const copyRssBtn = document.getElementById('copy-rss-action');
    let pagefindInitialized = false;

    function mountPagefindUI() {
      if (pagefindInitialized || !modal) return;
      // @ts-ignore
      if (typeof PagefindUI !== 'undefined' && !modal.dataset.pagefindLoaded) {
        // @ts-ignore
        new PagefindUI({
          element: '#pagefind-search',
          showSubresults: true,
          showImages: false,
          resetStyles: false
        });
        pagefindInitialized = true;
        modal.dataset.pagefindLoaded = 'true';
      }
    }

    function openModal() {
      if (!modal) return;
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      mountPagefindUI();

      setTimeout(() => {
        const input = modal.querySelector('input');
        if (input) input.focus();
      }, 50);
    }

    function closeModal() {
      if (!modal) return;
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // 1. Custom event listener
    window.addEventListener('open-search', openModal);

    // 2. Mobile touch delegation (.closest handles inner SVG/path clicks)
    const handleTrigger = (e: Event) => {
      const target = e.target as HTMLElement | null;
      const triggerBtn = target?.closest('#search-trigger-btn, [data-search-trigger]');
      
      if (triggerBtn) {
        e.preventDefault();
        openModal();
      }
    };

    document.addEventListener('click', handleTrigger);

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal?.style.display === 'flex') {
          closeModal();
        } else {
          openModal();
        }
      }
      if (e.key === 'Escape') closeModal();
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    copyRssBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(`${window.location.origin}/rss.xml`);
      copyRssBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyRssBtn.innerHTML = '<kbd class="text-[10px] bg-white/10 px-1 rounded">RSS</kbd> Copy Feed';
      }, 2000);
    });
  }

  document.addEventListener('DOMContentLoaded', initSearchModal);
  document.addEventListener('astro:page-load', initSearchModal);
</script>