<div id="progress-bar" class="fixed top-0 left-0 h-[2px] w-0 bg-gradient-to-r from-accent via-emerald-400 to-purple-500 z-50 transition-all duration-75 ease-out"></div>

<script>
  function initProgressBar() {
    const bar = document.getElementById('progress-bar')!;
    if (!bar) return;

    let ticking = false;

    function updateProgress() {
      const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = totalHeight > 0 ? (window.scrollY / totalHeight) * 100 : 0;
      bar.style.width = `${progress}%`;
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }, { passive: true });

    updateProgress();
  }

  document.addEventListener('DOMContentLoaded', initProgressBar);
  document.addEventListener('astro:page-load', initProgressBar);
</script>