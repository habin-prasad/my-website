---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
  body?: string;
}

const { title, description, pubDate, slug, tags = [], body = '' } = Astro.props;

const words = body ? body.split(/\s+/).length : 0;
const readingTime = words > 0 ? `${Math.ceil(words / 200)} min read` : null;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric'
});
---

<a 
  href={`/blog/${slug}/`} 
  class="group block p-5 sm:p-6 rounded-2xl bg-surface border border-white/10 hover:border-accent/40 active:scale-[0.99] transition-all flex flex-col justify-between h-full"
>
  <div class="space-y-3">
    <div class="flex items-center gap-2 font-mono text-xs text-accent">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {readingTime && <span class="text-neutral-600">•</span>}
      {readingTime && <span class="text-neutral-400">{readingTime}</span>}
    </div>

    <h2 class="text-base sm:text-lg font-bold text-white group-hover:text-accent transition-colors leading-snug">
      {title}
    </h2>

    <p class="text-xs sm:text-sm text-neutral-400 line-clamp-2 leading-relaxed">
      {description}
    </p>
  </div>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 pt-4 mt-2 border-t border-white/5">
      {tags.map(tag => (
        <span class="font-mono text-[11px] text-neutral-400 bg-white/5 border border-white/10 px-2 py-0.5 rounded transition-colors group-hover:border-accent/20">
          #{tag}
        </span>
      ))}
    </div>
  )}
</a>