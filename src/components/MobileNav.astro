---
const navItems = [
  {
    label: 'Home',
    href: '/',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`
  },
  {
    label: 'Systems',
    href: '/projects',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
  },
  {
    label: 'Journal',
    href: '/blog',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`
  },
  {
    label: 'Me',
    href: '/about',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />`
  }
];

const currentPath = Astro.url.pathname;
---

<!-- Fixed App-Style Bottom Dock for Mobile (< md) with Safe Area Support -->
<nav class="md:hidden fixed bottom-4 inset-x-4 z-50 mb-[env(safe-area-inset-bottom,0px)]">
  <div class="bg-[#09090b]/90 backdrop-blur-2xl border border-white/15 rounded-full px-3 py-2 shadow-2xl flex items-center justify-around">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`flex flex-col items-center justify-center py-1.5 px-3 rounded-full transition-all duration-200 min-h-[44px] min-w-[44px] active:scale-95 ${
            isActive 
              ? 'text-accent bg-accent/15 font-bold scale-105' 
              : 'text-neutral-400 hover:text-white'
          }`}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><Fragment set:html={item.icon} /></svg>
          <span class="text-[10px] font-mono mt-0.5 tracking-tight">{item.label}</span>
        </a>
      );
    })}
  </div>
</nav>