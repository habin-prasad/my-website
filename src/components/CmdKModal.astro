---
// src/components/CmdKContact.astro
---

<!-- Trigger FAB Button (Offset on mobile to clear bottom dock) -->
<button 
  id="cmdk-trigger" 
  class="fixed bottom-20 right-4 sm:bottom-6 sm:right-6 z-40 group flex items-center gap-2.5 bg-white text-black px-4 py-3 sm:px-5 sm:py-3 rounded-full font-bold shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200"
  aria-label="Open contact form"
>
  <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
  </svg>
  <span class="text-xs sm:text-sm font-mono">Initiate Sequence</span>
  <kbd class="hidden sm:inline-flex items-center gap-1 bg-black/10 px-2 py-0.5 rounded text-xs font-mono font-medium opacity-80">
    <span class="text-[10px]">⌘</span>J
  </kbd>
</button>

<!-- Native Dialog Component (Mobile Bottom Sheet / Desktop Centered Modal) -->
<dialog 
  id="cmdk-modal" 
  class="backdrop:bg-black/80 backdrop:backdrop-blur-md bg-transparent w-full max-w-xl p-0 sm:p-4 m-0 sm:m-auto fixed inset-x-0 bottom-0 sm:inset-0 z-50 open:animate-in open:fade-in open:slide-in-from-bottom duration-200"
>
  <div class="bg-[#09090b] border-t sm:border border-white/10 rounded-t-3xl sm:rounded-2xl shadow-2xl overflow-hidden text-white w-full max-h-[90vh] overflow-y-auto">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-white/10 bg-white/5 sticky top-0 backdrop-blur-md z-10">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-accent animate-pulse shadow-[0_0_10px_theme(colors.accent)]"></span>
        <h3 class="font-mono text-xs sm:text-sm tracking-widest text-neutral-300">SECURE_CHANNEL</h3>
      </div>
      <button id="cmdk-close" class="p-1 text-neutral-400 hover:text-white transition-colors" aria-label="Close modal">
        <kbd class="bg-white/10 px-2 py-1 rounded text-xs font-mono border border-white/10">ESC</kbd>
      </button>
    </div>
    
    <!-- Contact Form -->
    <form id="contact-form" action="/api/contact" method="POST" class="p-5 sm:p-6 flex flex-col gap-5">
      
      <div class="flex flex-col gap-2">
        <label for="email" class="text-xs font-mono text-neutral-400">TARGET_EMAIL</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="cto@company.com" 
          class="bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-neutral-600 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all font-sans" 
        />
      </div>
      
      <div class="flex flex-col gap-2">
        <label for="message" class="text-xs font-mono text-neutral-400">SYSTEM_STATUS / MESSAGE</label>
        <textarea 
          id="message" 
          name="message" 
          required 
          rows="4" 
          placeholder="Tell me about the infrastructure fire..." 
          class="bg-black/50 border border-white/10 rounded-xl px-4 py-3 text-sm text-white placeholder-neutral-600 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all resize-none font-sans"
        ></textarea>
      </div>

      <!-- Turnstile Integration -->
      <div class="cf-turnstile" data-sitekey="YOUR_TURNSTILE_SITE_KEY" data-theme="dark"></div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 pb-[env(safe-area-inset-bottom,0px)]">
        <p class="text-xs text-neutral-500 font-mono hidden sm:block">Routing via Edge Network</p>
        <button 
          type="submit" 
          class="w-full sm:w-auto bg-accent text-black font-mono font-bold text-sm px-6 py-3 rounded-xl hover:bg-[#b3e600] active:scale-95 transition-all flex items-center justify-center gap-2"
        >
          <span>Deploy Message</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('cmdk-modal') as HTMLDialogElement;
    const trigger = document.getElementById('cmdk-trigger');
    const closeBtn = document.getElementById('cmdk-close');
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
    const btnText = submitBtn?.querySelector('span');

    if (!modal) return;

    const openModal = () => {
      modal.showModal();
      document.body.style.overflow = 'hidden'; 
      setTimeout(() => emailInput?.focus(), 50); 
    };

    const closeModal = () => {
      modal.close();
      document.body.style.overflow = '';
    };

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'j') {
        e.preventDefault();
        modal.open ? closeModal() : openModal();
      }
    });

    trigger?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    
    modal.addEventListener('click', (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        closeModal();
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (!btnText || !submitBtn) return;

      const originalText = btnText.innerText;
      btnText.innerText = 'Transmitting...';
      submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
      submitBtn.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (response.ok) {
          btnText.innerText = 'Deployed Successfully';
          submitBtn.classList.replace('bg-accent', 'bg-white');
          
          setTimeout(() => {
            closeModal();
            form.reset();
            
            if (typeof (window as any).turnstile !== 'undefined') {
              (window as any).turnstile.reset();
            }
            
            btnText.innerText = originalText;
            submitBtn.classList.replace('bg-white', 'bg-accent');
            submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            submitBtn.disabled = false;
          }, 2000);
        } else {
          throw new Error(result.error || 'Submission failed');
        }
      } catch (error) {
        btnText.innerText = 'Transmission Failed';
        submitBtn.classList.replace('bg-accent', 'bg-red-500');
        
        setTimeout(() => {
          btnText.innerText = originalText;
          submitBtn.classList.replace('bg-red-500', 'bg-accent');
          submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
          submitBtn.disabled = false;
        }, 3000);
      }
    });
  });
</script>