---
// src/components/CmdKModal.astro
// You can import your existing Turnstile component here later
---

<!-- The native dialog element. The backdrop pseudo-element handles the background blur. -->
<dialog 
  id="cmdk-modal" 
  class="m-auto w-full max-w-lg bg-transparent p-4 backdrop:bg-black/70 backdrop:backdrop-blur-md open:animate-fade-in"
>
  <div class="relative w-full rounded-2xl border border-white/10 bg-surface shadow-2xl overflow-hidden flex flex-col text-left">
    
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-white/10 bg-white/5 px-6 py-4">
      <div class="flex items-center gap-3">
        <span class="rounded bg-accent/20 px-2 py-1 text-[10px] font-bold font-mono text-accent border border-accent/20">CMD K</span>
        <h2 class="text-sm font-medium text-white tracking-wide uppercase font-mono">Secure Transmission</h2>
      </div>
      <button id="close-cmdk" class="text-neutral-500 hover:text-white transition-colors p-1 rounded-md hover:bg-white/10 outline-none">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- The Form (Update the action/method to match your existing API route) -->
    <form action="/api/contact" method="POST" class="flex flex-col gap-5 p-6">
      <div>
        <p class="text-xl font-bold text-white mb-1">Let's fix your infrastructure.</p>
        <p class="text-sm text-neutral-400">Where should I send the solution?</p>
      </div>

      <!-- Inputs with glassmorphic styling -->
      <input 
        type="email" 
        name="email" 
        placeholder="manager@company.com" 
        required
        class="w-full rounded-xl border border-white/10 bg-black/50 px-4 py-3 text-white placeholder-neutral-600 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-all font-mono text-sm"
      />
      
      <textarea 
        name="message" 
        placeholder="Describe the system that is currently on fire..." 
        required
        rows="3"
        class="w-full rounded-xl border border-white/10 bg-black/50 px-4 py-3 text-white placeholder-neutral-600 focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent transition-all resize-none font-mono text-sm"
      ></textarea>

      <!-- Drop your existing Cloudflare Turnstile component here -->
      <div class="h-[65px] w-full rounded-lg border border-dashed border-white/10 bg-black/20 flex items-center justify-center text-xs font-mono text-neutral-500">
        [ Cloudflare Turnstile Mount ]
      </div>

      <button 
        type="submit" 
        class="group relative w-full overflow-hidden rounded-xl bg-accent px-4 py-3 font-bold text-black transition-transform hover:scale-[1.02] active:scale-[0.98]"
      >
        <span class="relative z-10 flex items-center justify-center gap-2">
          Deploy Message
          <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </span>
      </button>
    </form>
  </div>
</dialog>

<!-- Floating Action Button for Mobile / Mouse users -->
<button 
  id="fab-cmdk" 
  class="fixed bottom-6 right-6 z-40 group flex h-14 w-14 items-center justify-center rounded-full border border-white/10 bg-surface/80 backdrop-blur-xl text-white shadow-2xl transition-all hover:border-accent hover:text-accent hover:scale-110 outline-none focus:border-accent focus:ring-2 focus:ring-accent/50"
  aria-label="Contact Me"
>
  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
  
  <!-- Hover Tooltip -->
  <span class="absolute right-full mr-4 hidden -translate-y-1/2 top-1/2 whitespace-nowrap rounded-md border border-white/10 bg-surface px-2 py-1 text-xs font-mono text-neutral-400 group-hover:block">
    Cmd + K
  </span>
</button>

<script>
  document.addEventListener('astro:page-load', () => {
    const dialog = document.getElementById('cmdk-modal') as HTMLDialogElement;
    const closeBtn = document.getElementById('close-cmdk');
    const fabBtn = document.getElementById('fab-cmdk');

    if (!dialog) return;

    // Open Modal function
    const openModal = () => dialog.showModal();
    const closeModal = () => dialog.close();

    // 1. Listen for Keyboard Shortcut (Cmd+K or Ctrl+K)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault(); // Prevent browser search bar
        dialog.open ? closeModal() : openModal();
      }
    });

    // 2. Click Handlers
    fabBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    // 3. Close when clicking the backdrop (outside the form content)
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height
        && rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
      if (!isInDialog) {
        closeModal();
      }
    });
  });
</script>

<style>
  /* Optional: Smooth fade-in for the dialog */
  dialog[open] {
    animation: zoom-in 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes zoom-in {
    0% { opacity: 0; transform: scale(0.95); }
    100% { opacity: 1; transform: scale(1); }
  }

  /* Hide scrollbar on body when modal is open */
  :global(body:has(dialog[open])) {
    overflow: hidden;
  }
</style>