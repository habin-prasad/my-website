---
interface Props {
  title?: string;
  icon?: string;
  viewAllHref?: string;
}

const { title, icon, viewAllHref } = Astro.props;
---

<div class="w-full my-6">
  {title && (
    <div class="flex items-center justify-between px-4 mb-3">
      <div class="flex items-center gap-2">
        {icon && <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><Fragment set:html={icon} /></svg>}
        <h2 class="text-sm font-mono text-neutral-300 uppercase tracking-wider">{title}</h2>
      </div>
      {viewAllHref && (
        <a href={viewAllHref} class="text-xs font-mono text-accent hover:underline flex items-center gap-1">
          <span>All</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      )}
    </div>
  )}

  <!-- Scroll-Snap Horizontal Container -->
  <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 px-4 pb-4 no-scrollbar scroll-smooth">
    <slot />
  </div>
</div>

<style>
  /* Hide scrollbar for clean app experience */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>