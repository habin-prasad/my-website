---
// src/components/BentoGrid.astro
---

<section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-32">
  <!-- 
    The Grid: 
    - 1 column on mobile
    - 4 columns on desktop 
    - Fixed row heights (200px) allow us to span items cleanly
  -->
  <div class="grid grid-cols-1 md:grid-cols-4 auto-rows-[200px] gap-4 reveal-card opacity-0 translate-y-8 transition-all duration-700 ease-out">

    <!-- 1. Flagship Project (Spans 2 columns, 2 rows) -->
    <a 
      href="/blog/global-api-gateway" 
      class="group relative col-span-1 md:col-span-2 md:row-span-2 rounded-3xl bg-surface border border-white/10 p-8 overflow-hidden flex flex-col justify-end transition-all hover:border-accent/50"
    >
      <!-- Hover Gradient Glow -->
      <div class="absolute inset-0 bg-gradient-to-br from-accent/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
      
      <!-- Abstract visual shape -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 group-hover:bg-accent/20 transition-colors duration-700"></div>
      
      <div class="relative z-10">
        <p class="text-accent font-mono text-sm mb-3">01 / Architecture</p>
        <h3 class="text-3xl md:text-4xl font-bold text-white mb-3 tracking-tight">Global API Gateway</h3>
        <p class="text-neutral-400 max-w-sm">
          Built a distributed, edge-first API router reducing cross-region latency and balancing loads instantly.
        </p>
      </div>
    </a>

    <!-- 2. The Metric (Spans 2 columns, 1 row) -->
    <!-- Hiring managers read numbers. Put the ROI front and center. -->
    <div class="col-span-1 md:col-span-2 md:row-span-1 rounded-3xl bg-surface border border-white/10 p-8 flex flex-col justify-center relative overflow-hidden group">
      <div class="absolute top-0 right-0 w-full h-full bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <p class="text-neutral-400 text-sm uppercase tracking-wider mb-2 font-mono">System Optimization</p>
      <div class="flex items-baseline gap-1">
        <h2 class="text-5xl md:text-6xl font-bold text-white tracking-tighter">-400</h2>
        <span class="text-3xl text-accent font-bold">ms</span>
      </div>
      <p class="text-sm text-neutral-500 mt-2">
        Reduction in p99 API latency by migrating to Upstash Redis edge caching.
      </p>
    </div>

    <!-- 3. Tech Stack (Spans 1 column, 2 rows) -->
    <!-- Minimalist pill tags instead of noisy logos -->
    <div class="col-span-1 md:col-span-1 md:row-span-2 rounded-3xl bg-surface border border-white/10 p-8 flex flex-col">
      <h3 class="text-white font-bold mb-6 text-xl tracking-tight">Core Stack</h3>
      <div class="flex flex-wrap gap-2">
        {['Astro', 'TypeScript', 'Redis', 'Cloudflare', 'Tailwind CSS', 'Node.js', 'Docker'].map((tech) => (
          <span class="px-3 py-1.5 rounded-full border border-white/10 bg-white/5 text-xs text-neutral-300 font-mono">
            {tech}
          </span>
        ))}
      </div>
    </div>

    <!-- 4. GitHub / Outbound Link (Spans 1 column, 1 row) -->
    <!-- Uses the high-contrast accent color to draw the eye -->
    <a 
      href="https://github.com/yourusername" 
      target="_blank"
      class="group col-span-1 md:col-span-1 md:row-span-1 rounded-3xl bg-accent text-black p-8 flex flex-col justify-between hover:scale-[0.98] transition-transform duration-200"
    >
      <div class="flex justify-between items-start">
        <h3 class="font-bold text-2xl tracking-tight">GitHub</h3>
        <svg class="w-6 h-6 transform group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </div>
      <p class="font-medium text-sm opacity-80">Inspect the source code.</p>
    </a>

    <!-- 5. Secondary Project (Spans 2 columns, 1 row) -->
    <a 
      href="/blog/zero-trust-security" 
      class="group relative col-span-1 md:col-span-2 md:row-span-1 rounded-3xl bg-surface border border-white/10 p-8 overflow-hidden flex flex-col justify-center transition-colors hover:border-white/30"
    >
      <div class="relative z-10 flex items-center justify-between">
        <div>
          <p class="text-neutral-400 font-mono text-sm mb-2">02 / Security</p>
          <h3 class="text-2xl font-bold text-white tracking-tight">Zero-Trust Bot Mitigation</h3>
        </div>
        <div class="w-12 h-12 rounded-full border border-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-black transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </div>
      </div>
    </a>

  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.remove('opacity-0', 'translate-y-8');
              entry.target.classList.add('opacity-100', 'translate-y-0');
            }, index * 100);

            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -50px 0px', threshold: 0.1 }
    );

    document.querySelectorAll('.reveal-card').forEach((el) => observer.observe(el));
  });
</script>