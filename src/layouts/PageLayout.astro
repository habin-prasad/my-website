---
// src/layouts/PageLayout.astro
import Base from './Base.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  containerWidth?: 'narrow' | 'wide';
}

const { 
  title, 
  subtitle, 
  description, 
  containerWidth = 'wide' 
} = Astro.props;
---

<Base title={title} description={description}>
  <div class={containerWidth === 'narrow' ? 'container-narrow' : 'container-wide'}>
    <header class="page-header">
      <h1 class="page-title">{title}</h1>
      {subtitle && <p class="page-subtitle">{subtitle}</p>}
    </header>

    <!-- Slot handles dynamic body content without repeating container wrapper classes -->
    <main class="page-body">
      <slot />
    </main>
  </div>
</Base>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }
  .page-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0 0 0.5rem 0;
  }
  .page-subtitle {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0;
  }
  .page-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>