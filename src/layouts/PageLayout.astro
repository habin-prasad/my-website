---
import Base from './Base.astro';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  containerWidth?: 'narrow' | 'wide';
}

const { title, subtitle, description, containerWidth = 'wide' } = Astro.props;
const widthClass = containerWidth === 'narrow' ? 'max-w-3xl' : 'max-w-7xl';
---

<Base title={title} description={description}>
  <div class:list={['mx-auto w-full px-4 sm:px-6 lg:px-8', widthClass]}>
    <header class="mb-6 pt-6 sm:mb-10 sm:pt-10">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h1>
      {subtitle && <p class="mt-2 max-w-3xl text-base leading-relaxed text-muted sm:text-lg">{subtitle}</p>}
    </header>
    <div data-pagefind-body class="pb-10 sm:pb-14">
      <slot />
    </div>
  </div>
</Base>
