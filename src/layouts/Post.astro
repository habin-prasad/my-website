---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
}
const { title, description, pubDate } = Astro.props;
---
<Base title={`${title} `} description={description}>
  <article class="post-content">
    <h1>{title}</h1>
    <p class="post-meta">{pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    <slot />
  </article>
</Base>   