---
import '../styles/global.css'; // Adjust path if your CSS is at src/global.css
import SearchTrigger from '../components/SearchTrigger.astro';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const SITE_NAME = "hp"; // Define site name variable once
const DEFAULT_DESCRIPTION = "Personal website & engineering journal.";

const { title, description = DEFAULT_DESCRIPTION, image = '/og-image.png' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://hp.com');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Pagefind 1.5.0 Component UI Assets -->
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-component-ui.js" is:inline></script>
    <link rel="alternate" type="application/rss+xml" title="Habin's Blog" href="/rss.xml" />
  </head>
  <body>
    <header class="header">
      <nav class="nav">
        <a href="/" class="nav-brand">habin<span class="brand-accent">.dev</span></a>
        
        <div class="nav-links">
          <a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About</a>
          <a href="/blog" class={currentPath.startsWith('/blog') ? 'active' : ''}>Blog</a>
          <a href="/projects" class={currentPath.startsWith('/projects') ? 'active' : ''}>Projects</a>
          
          <SearchTrigger />
        </div>
      </nav>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-content">
        <p>© 2026 Habin Prasad • Built with Astro 7 & Cloudflare Pages</p>
      </div>
    </footer>


    <SearchModal />
  </body>
</html>